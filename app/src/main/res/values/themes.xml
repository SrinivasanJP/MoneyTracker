<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Force Dark -->
    <style name="Base.Theme.MoneyTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="android:colorBackground">@color/darkBg</item>
        <item name="colorSurface">@color/darkSurface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:statusBarColor">@color/darkBg</item>
    </style>

    <style name="Theme.MoneyTracker" parent="Base.Theme.MoneyTracker" />

    <style name="Theme.MoneyTracker.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:colorBackground">@color/darkCard</item>
        <item name="colorSurface">@color/darkCard</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>