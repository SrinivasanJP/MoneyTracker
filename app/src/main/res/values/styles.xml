<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DataTextStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/primary_bold</item>
        <item name="android:textColor">@color/colorPrimaryVariant</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/primary_bold</item>
        <item name="android:textColor">@color/gray500</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/primary_medium</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="StatsSectionTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/primary_bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="TabTextStyle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/primary_bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>