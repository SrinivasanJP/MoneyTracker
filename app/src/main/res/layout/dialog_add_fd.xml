<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/primary_bold"
        android:text="Add Fixed Deposit"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="FD / Bond Name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/primary_medium"
            android:inputType="text"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Invested Amount (₹)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdInvested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/primary_medium"
            android:inputType="numberDecimal"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Interest Rate (% per year)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdInterestRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/primary_medium"
            android:inputType="numberDecimal"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Interest Cycle (in months, e.g. 1, 3, 6, 12)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFdInterestCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/primary_medium"
            android:inputType="number"
            android:textColor="@color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Interest Type: Simple (Direct) / Compound (Growth) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/primary_medium"
        android:text="Interest Type"
        android:textColor="@color/gray600"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/rgInterestType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSimple"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Simple (Direct)"
            android:textColor="@color/gray700"
            android:fontFamily="@font/primary_medium"
            android:textSize="13sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbCompound"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Compound (Growth)"
            android:textColor="@color/gray700"
            android:fontFamily="@font/primary_medium"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- Interest Credit Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/primary_medium"
        android:text="Next Interest Credit Date"
        android:textColor="@color/gray600"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvFdCreditDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/component_rounded_gray_tag"
        android:fontFamily="@font/primary_bold"
        android:gravity="center"
        android:padding="12dp"
        android:text="Tap to select date"
        android:textColor="@color/wealthAccent"
        android:textSize="15sp" />

</LinearLayout>
