<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/component_wealth_card"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- FD Name + Type Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvFdDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/primary_bold"
            android:text="FD Name"
            android:textColor="@color/wealthTextPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFdDetailType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/component_wealth_tag"
            android:fontFamily="@font/primary_medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Simple"
            android:textColor="@color/wealthAccent"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Row: Invested | Interest Rate | Cycle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVESTED"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailInvested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                android:textColor="@color/wealthTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTEREST RATE"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/wealthTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CYCLE"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailCycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly"
                android:textColor="@color/wealthTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/wealthDivider" />

    <!-- Row: Current Value | Interest Earned (P&L) | Next Credit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT VALUE"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                android:textColor="@color/wealthAccent"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INTEREST EARNED"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailEarned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹ 0"
                android:textColor="@color/wealthProfit"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEXT CREDIT"
                android:textColor="@color/wealthTextSecondary"
                android:textSize="10sp"
                android:fontFamily="@font/primary_medium"
                android:letterSpacing="0.1" />
            <TextView
                android:id="@+id/tvFdDetailNextCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/wealthTextPrimary"
                android:textSize="13sp"
                android:fontFamily="@font/primary_bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnEditFdDetail"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="Edit"
            android:src="@drawable/ic_edit_slim"
            app:tint="@color/wealthTextSecondary" />

        <ImageView
            android:id="@+id/btnDeleteFdDetail"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:layout_gravity="center_vertical"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete_slim"
            app:tint="@color/wealthLoss" />
    </LinearLayout>
</LinearLayout>
