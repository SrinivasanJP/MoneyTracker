<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wealthBg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header with gradient -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/component_wealth_gradient"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/btnAddCategory"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:contentDescription="Add Category"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/wealthAccent" />

                <!-- Net Worth Card (clickable → opens detail) -->
                <LinearLayout
                    android:id="@+id/netWorthCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/component_wealth_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/primary_medium"
                        android:text="TOTAL NET WORTH"
                        android:textColor="@color/wealthTextSecondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:id="@+id/tvTotalNetWorth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/primary_bold"
                        android:text="₹ 0.00"
                        android:textColor="@color/wealthAccent"
                        android:textSize="34sp" />

                    <TextView
                        android:id="@+id/tvTotalPnl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/primary_medium"
                        android:text=""
                        android:textColor="@color/wealthTextSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Asset Allocation - Stacked Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/component_wealth_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/primary_bold"
                    android:text="Asset Allocation"
                    android:textColor="@color/wealthTextPrimary"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- The stacked bar container -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/wealthDivider">

                    <LinearLayout
                        android:id="@+id/stackedBar"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:orientation="horizontal" />
                </androidx.cardview.widget.CardView>

                <!-- 0% / 100% labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/primary_regular"
                        android:text="0%"
                        android:textColor="@color/wealthTextSecondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/primary_regular"
                        android:text="100%"
                        android:textColor="@color/wealthTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Legend -->
                <LinearLayout
                    android:id="@+id/allocationLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
            </LinearLayout>



            <!-- Categories Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/primary_bold"
                android:text="Categories"
                android:textColor="@color/wealthAccent"
                android:textSize="18sp"
                android:letterSpacing="0.03" />

            <!-- Category list -->
            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical" />

            <!-- Export / Import row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/component_wealth_button"
                    android:fontFamily="@font/primary_bold"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="📤 Export"
                    android:textColor="@color/wealthBg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnImport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/component_wealth_button"
                    android:fontFamily="@font/primary_bold"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="📥 Import"
                    android:textColor="@color/wealthBg"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
