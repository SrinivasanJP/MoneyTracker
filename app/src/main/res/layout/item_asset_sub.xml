<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <!-- Item name -->
    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:fontFamily="@font/primary_medium"
        android:text="Asset Name"
        android:textColor="@color/gray600"
        android:textSize="14sp" />

    <!-- Right side: value + percentage + edit/delete -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/primary_medium"
            android:text="₹ 0"
            android:textColor="@color/gray700"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvItemPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/primary_regular"
            android:text="(0%)"
            android:textColor="@color/gray500"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btnEditItem"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Edit"
            android:src="@drawable/ic_edit_slim"
            app:tint="@color/gray500" />

        <ImageView
            android:id="@+id/btnDeleteItem"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete_slim"
            app:tint="@color/accentRed" />
    </LinearLayout>

    <!-- Divider at bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/gray200" />
</RelativeLayout>
